# --- Modelo ---------------------------------------------------------------
# Identificador del modelo. Con `simulado` se usa el modelo offline: ni red ni
# clave, respuestas deterministas (demo y pruebas).
RECEPCIONISTA_MODELO=deepseek-v4.1-flash

# Servicio de modelo: API compatible con OpenAI. La operación va a
# `${RECEPCIONISTA_BASE_URL}/chat/completions`. Sin valor no hay IA disponible.
RECEPCIONISTA_BASE_URL=

# Clave del servicio. Solo del lado del servidor: nunca en el navegador ni en el
# repositorio. Sin clave (o sin URL base) el servicio arranca en modo respaldo.
RECEPCIONISTA_API_KEY=

# --- Servidor -------------------------------------------------------------
# Puerto HTTP del servicio.
RECEPCIONISTA_PUERTO=8790

# Carpeta de datos: presupuesto mensual (data/presupuesto-YYYY-MM.json) y
# registro diario (data/registro-YYYY-MM-DD.jsonl).
RECEPCIONISTA_DATOS=./data

# Sal del hash de IP en los logs. Si queda vacía se genera una al arrancar.
RECEPCIONISTA_SAL=

# Pedidos simultáneos al modelo.
RECEPCIONISTA_CONCURRENCIA=4

# --- Límites --------------------------------------------------------------
# Tope de gasto mensual global, en dólares, persistido en
# data/presupuesto-YYYY-MM.json. Al agotarse se responde en modo respaldo.
RECEPCIONISTA_TOPE_USD_MES=0.50

# Tope diario de tokens totales (entrada + salida + caché). Corta el día cuando
# se llega a cualquiera de los dos topes, el de dólares o el de tokens.
RECEPCIONISTA_TOPE_TOKENS_DIA=3000000

# Precios en USD por millón de tokens, usados para estimar el costo de cada
# respuesta y alimentar el tope mensual.
RECEPCIONISTA_PRECIO_ENTRADA=0.05
RECEPCIONISTA_PRECIO_SALIDA=0.50

# Límite de pedidos por IP: por minuto y por día.
RECEPCIONISTA_POR_MINUTO=8
RECEPCIONISTA_POR_DIA=60

# --- Red ------------------------------------------------------------------
# Orígenes permitidos para CORS, separados por coma. Vacía = ninguno (el
# frontend servido desde el mismo sitio no lo necesita).
RECEPCIONISTA_ORIGENES=https://example.com

# Proxies confiables para aceptar `X-Real-IP`: IPs o CIDR IPv4 separados por coma.
# Vacía = solo loopback (127.0.0.1, ::1, ::ffff:127.0.0.1). Si se define la
# variable sin valores, ninguna IP es confiable y se usa siempre la del socket.
# Detrás de nginx en el mismo host alcanza el valor por defecto; en Docker con
# red bridge hay que agregar la IP del gateway, porque el socket que ve el
# proceso es el del gateway y no loopback. Las entradas mal formadas se ignoran
# (0.0.0.0/0 confiaría en todas: no usarlo).
RECEPCIONISTA_PROXIES_CONFIABLES=127.0.0.1,::1,::ffff:127.0.0.1

# --- Desarrollo -----------------------------------------------------------
# Solo desarrollo: carpeta que se sirve en `/` (por ejemplo, el sitio de la
# clínica para el e2e). Vacía = no se sirven estáticos.
RECEPCIONISTA_ESTATICOS=

# Zona horaria del proceso. El turnero trabaja en hora local: si no se define,
# el proceso fuerza America/Argentina/Buenos_Aires.
TZ=America/Argentina/Buenos_Aires
